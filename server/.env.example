PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# Supabase — fill these in from your project settings
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Session Pooler connection string
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Must match a bucket that exists in Supabase → Storage.
STORAGE_BUCKET=complaint-photos

# ============================================================
# AI
# ============================================================
AI_VISION_PROVIDER=gemini
LOCAL_VISION_URL=http://localhost:8000

AI_PROVIDER=gemini
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

AI_CACHE=false

# ============================================================
# Background jobs
# ============================================================
RUN_JOBS=true
